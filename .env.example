# =====================================================================
# BagiPanen — daftar variabel lingkungan (template, TANPA nilai rahasia)
#
# Salin bagian yang relevan ke file .env milik tiap paket:
#   - bagian "contracts/" → contracts/.env
#   - bagian "agent/"     → agent/.env
#   - bagian "web/"       → web/.env.local
# Jangan pernah commit file .env asli.
#
# APP_MODE / NEXT_PUBLIC_APP_MODE: "local" (Anvil, penyimpanan lokal,
# MockVision) atau "testnet" (BSC testnet, Pinata, Gemini).
# Di mode local, API key & private key boleh kosong; alamat kontrak
# diambil dari deployments/anvil.json.
# =====================================================================

# ---- contracts/ ----
APP_MODE=local
BSC_TESTNET_RPC=            # RPC resmi BNB untuk deploy, mis. https://bsc-testnet-dataseed.bnbchain.org
DEPLOYER_PRIVATE_KEY=       # wallet admin, KHUSUS testnet
BSCSCAN_API_KEY=            # untuk forge verify-contract
ERC8004_IDENTITY_REGISTRY=  # dari docs/erc8004-notes.md (kosong = pakai MockAgentIdentity)
# Seed phrase wallet testnet (12 kata, dalam tanda kutip) untuk `npm run seed:testnet`
TESTNET_MNEMONIC=
# Opsional: tBNB yang dibagikan admin ke tiap akun demo (wei), bawaan 0,02 tBNB
TBNB_PER_ACCOUNT=

# ---- agent/ ----
APP_MODE=local
AGENT_PRIVATE_KEY=          # wallet agen, KHUSUS testnet
GEMINI_API_KEY=
GEMINI_MODEL=               # model Flash terbaru yang mendukung gambar, mis. gemini-3.8-flash
GEMINI_FALLBACK_MODELS=     # opsional, dipisah koma; dicoba bila model utama sibuk/timeout
PINATA_JWT=
IPFS_GATEWAY=               # gateway Pinata Anda
FACTORY_ADDRESS=
START_BLOCK=                # blok deploy factory
# RPC yang mendukung eth_getLogs tanpa filter alamat (PRD), mis. https://rpc.sentio.xyz/bsc-testnet.
# https://bsc-testnet-rpc.publicnode.com juga bisa: agen otomatis memfilter dengan daftar kampanye resmi.
BSC_TESTNET_RPC=
# Opsional (kosong = bawaan): LOCAL_RPC_URL=http://127.0.0.1:8545, LOCAL_IPFS_DIR=../web/.local-ipfs,
# POLL_INTERVAL_MS=10000, RETRY_DELAY_MS=15000, MAX_LOG_RANGE=50000 (testnet),
# GEMINI_TIMEOUT_MS=45000, GEMINI_QUOTA_COOLDOWN_MS=600000 (model yang kena 429 dilewati selama ini)

# ---- web/ (NEXT_PUBLIC_ boleh terlihat di browser) ----
NEXT_PUBLIC_APP_MODE=local
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_RESERVE_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_IDR_PER_USDT=16000
# Opsional: RPC Anvil (mode local) dan RPC BSC testnet yang mendukung eth_getLogs (mode testnet),
# mis. https://bsc-testnet-rpc.publicnode.com. NEXT_PUBLIC_LOG_CHUNK_BLOCKS = rentang getLogs per panggilan (bawaan 50000)
NEXT_PUBLIC_LOCAL_RPC_URL=
NEXT_PUBLIC_BSC_TESTNET_RPC=
NEXT_PUBLIC_LOG_CHUNK_BLOCKS=
